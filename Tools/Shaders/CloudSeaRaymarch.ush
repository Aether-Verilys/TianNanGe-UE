// Original local cloud-bank shader. No external textures or marketplace assets.
// World distances are centimetres. RGB is unpremultiplied for translucent blending.
struct CloudSeaField
{
    float Hash(float3 p)
    {
        p = frac(p * 0.1031);
        p += dot(p, p.yzx + 33.33);
        return frac((p.x + p.y) * p.z);
    }
    float Noise(float3 p)
    {
        float3 i = floor(p), f = frac(p);
        f = f * f * (3.0 - 2.0 * f);
        return lerp(lerp(lerp(Hash(i), Hash(i + float3(1,0,0)), f.x),
                         lerp(Hash(i + float3(0,1,0)), Hash(i + float3(1,1,0)), f.x), f.y),
                    lerp(lerp(Hash(i + float3(0,0,1)), Hash(i + float3(1,0,1)), f.x),
                         lerp(Hash(i + float3(0,1,1)), Hash(i + float3(1,1,1)), f.x), f.y), f.z);
    }
    float DensityAt(float3 p, float3 center, float3 extent, float scale, float time, float seed, float bridgeY)
    {
        float3 q = (p - center) / extent;
        float envelope = saturate((1.0 - dot(q, q)) * 2.6);
        float3 n = (p + float3(-0.57, 0.82, 0.035) * time) / max(scale, 10.0) + seed;
        float shape = Noise(n) * 0.57 + Noise(n * 2.03 + 7.1) * 0.29 + Noise(n * 4.11 + 17.3) * 0.14;
        float density = saturate(envelope * 0.98 - (1.0 - shape) * 0.88 - 0.08);
        // Keep a soft clear corridor through the bank for the bridge and hero.
        density *= smoothstep(125.0, 235.0, abs(p.y - bridgeY));
        return density * density * (3.0 - 2.0 * density);
    }
};
CloudSeaField field;
float3 extent = max(CloudExtent, 1.0);
float3 ro = CameraPos - CloudCenter;
bool inside = all(abs(ro) < extent);
if ((inside && Facing > 0.0) || (!inside && Facing < 0.0)) return float4(0,0,0,0);
float3 viewRay = WorldPos - CameraPos;
float rayLength = max(length(viewRay), 0.001);
float3 rd = viewRay / rayLength;
float3 inverseRay = rcp(rd + float3(0.000001, 0.000001, 0.000001));
float3 ta = (-extent - ro) * inverseRay;
float3 tb = ( extent - ro) * inverseRay;
float3 nearT = min(ta, tb), farT = max(ta, tb);
float start = max(0.0, max(nearT.x, max(nearT.y, nearT.z)));
float sceneDistance = SceneDepthCm * rayLength / max(PixelDepthCm, 0.01);
float finish = min(min(farT.x, min(farT.y, farT.z)), sceneDistance);
if (finish <= start) return float4(0,0,0,0);
int count = (int)clamp(StepCount, 16.0, 64.0);
float stepLength = (finish - start) / count;
float transmission = 1.0;
float3 sum = 0.0;
float3 sun = normalize(SunDirection);
[loop]
for (int index = 0; index < 64; ++index)
{
    if (index >= count || transmission < 0.035) break;
    float t = start + (index + 0.5) * stepLength;
    float3 p = CameraPos + rd * t;
    float rho = field.DensityAt(p, CloudCenter, extent, NoiseScale, TimeSeconds * WindSpeed, Seed, BridgeY) * Density;
    rho *= smoothstep(0.0, 55.0, sceneDistance - t);
    if (rho < 0.001) continue;
    float shadowRho = field.DensityAt(p + sun * 115.0, CloudCenter, extent, NoiseScale, TimeSeconds * WindSpeed, Seed, BridgeY);
    float height = saturate((p.z - CloudCenter.z) / extent.z * 0.5 + 0.5);
    float illumination = saturate(0.24 + 0.72 * height - 0.42 * shadowRho);
    float3 radiance = lerp(ShadowColor, HighlightColor, illumination) * Brightness;
    float alpha = 1.0 - exp(-rho * max(Extinction, 0.0) * stepLength);
    sum += transmission * alpha * radiance;
    transmission *= 1.0 - alpha;
}
float alpha = 1.0 - transmission;
return float4(sum / max(alpha, 0.0001), min(alpha, 0.94));
